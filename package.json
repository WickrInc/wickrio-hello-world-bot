{
  "name": "@wickr-sample-integrations/wickrio-hello-world-bot",
  "version": "6.66.0",
  "description": "Wickr's own Hello World Bot",
  "main": "hello_world_bot.js",
  "dependencies": {
    "body-parser": "^1.19.0",
    "dotenv": "^8.2.0",
    "fs": "0.0.2",
    "prompt": "^1.0.0",
    "wickrio-bot-api": "7.1.x"
  },
  "scripts": {
    "start": "nohup wpm2 start --no-metrics ./wpm.json >>wpm2.output 2>&1 & echo $! > $(cat pidLocation.json)",
    "stop": "kill $(cat $(cat pidLocation.json))",
    "restart": "kill $(cat $(cat pidLocation.json)) && nohup wpm2 start --no-metrics ./wpm.json >>wpm2.output 2>&1 & echo $! > $(cat pidLocation.json)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WickrInc/wickrio-hello-world-bot"
  },
  "keywords": [
    "wickr",
    "wickrio",
    "wickrbot",
    "bot",
    "bots",
    "secure",
    "messaging",
    "api",
    "wickrsampleintegrations"
  ],
  "database": true
}
